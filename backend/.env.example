# Backend Environment Variables for Vercel / Production
PORT=4000

# MongoDB Atlas Connection URI
# Note: Ensure your MongoDB Atlas Network Access whitelist includes 0.0.0.0/0 (allow access from anywhere)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/e-commerce?retryWrites=true&w=majority"

# JWT Secret Key
JWT_SECRET="your_secure_jwt_secret_key"

# Cloudinary Storage Configuration
CLOUDINARY_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_SECRET_KEY="your_cloudinary_secret_key"

# Admin Credentials
ADMIN_EMAIL="admin@elitekart.com"
ADMIN_PASSWORD="adminpassword123"

# Optional Payment Gateway Keys (if enabled)
STRIPE_SECRET_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
CURRENCY="usd"
